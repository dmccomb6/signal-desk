# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes automatically
CRON_SECRET=generate-a-long-random-string

# Passcode needed to add/remove tickers from the dashboard
APP_PASSCODE=choose-a-passcode

# Data provider: "yahoo" (default, no key, 2y history) or "alphavantage"
DATA_PROVIDER=yahoo
ALPHA_VANTAGE_API_KEY=
